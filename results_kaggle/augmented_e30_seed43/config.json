{
  "name": "augmented_e30",
  "data": {
    "root": "/kaggle/input/datasets/grassknoted/asl-alphabet/asl_alphabet_train/asl_alphabet_train",
    "official_test_root": "data/asl_alphabet_test",
    "image_size": 100,
    "images_per_class": 1000,
    "train_frac": 0.7,
    "val_frac": 0.15,
    "test_frac": 0.15,
    "split_seed": 1234
  },
  "aug": {
    "enabled": true,
    "rotation_deg": 12.0,
    "translate": 0.1,
    "scale_min": 0.9,
    "scale_max": 1.1,
    "brightness": 0.25,
    "contrast": 0.25,
    "saturation": 0.15,
    "hue": 0.02,
    "horizontal_flip": false
  },
  "train": {
    "model": "aslnet_original",
    "epochs": 30,
    "batch_size": 32,
    "lr": 0.001,
    "optimizer": "adam",
    "weight_decay": 0.0,
    "seed": 43,
    "device": "cuda",
    "num_workers": 4,
    "select_on": "val_macro_f1"
  }
}